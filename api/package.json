{
  "name": "service-pulse-api",
  "version": "1.0.0",
  "description": "API do gerenciador de chamados ServicePulse",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "pretest:e2e": "tsx test/e2e/setup.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knex": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts",
    "migrate:make": "npm run knex -- migrate:make",
    "migrate:latest": "npm run knex -- migrate:latest",
    "migrate:rollback": "npm run knex -- migrate:rollback",
    "seed:make": "npm run knex -- seed:make",
    "seed:run": "npm run knex -- seed:run"
  },
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.1",
    "fastify": "^5.12.5",
    "knex": "^3.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "private": true
}
